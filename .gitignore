# Run: python3 build_standalone.py  to regenerate.
THENDRAL_WIND_SERVICES_SERVICE_REPORT.html
Thendral_Wind_Service_Report.html

# --- NODE.JS ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# --- CACHES & BUILD FOLDERS ---
.cache/
dist/
build/
out/
.next/
.nuxt/
.vite/
.parcel-cache/

# --- MACOS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# --- EDITORS ---
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# --- FIREBASE EMULATOR / DEPLOYMENT CACHE ---
.firebase/
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log
