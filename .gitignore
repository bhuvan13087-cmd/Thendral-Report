# --- SECRETS & CREDENTIALS (NEVER commit these) ---
.env
.env.local
.env.*.local
*.env
service-account*.json
*-service-account.json
firebase-admin-*.json
google-services.json
GoogleService-Info.plist
*.pem
*.key
*.p12
*.pfx

# --- BUILD ARTIFACTS (Generated by build_standalone.py) ---
